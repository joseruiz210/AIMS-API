generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  INSTRUCTOR
  APRENDIZ
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum TipoNotificacion {
  INFO
  ADVERTENCIA
  URGENTE
}

enum EstadoAprendiz {
  EN_FORMACION
  EN_RIESGO
  CONDICIONADO
  RETIRO_VOLUNTARIO
  CERTIFICADO
}

enum Jornada {
  MANANA
  TARDE
  NOCHE
  MIXTA
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  TARDANZA
  EXCUSA
}

model User {
  id                       String          @id @default(uuid())
  firstName                String          @map("first_name")
  lastName                 String          @map("last_name")
  email                    String          @unique
  password                 String?
  authProvider             AuthProvider    @default(LOCAL) @map("auth_provider")
  role                     Role            @default(APRENDIZ)
  documentType             String?         @map("document_type")
  documentNumber           String?         @map("document_number")
  isPreRegistered          Boolean         @default(false) @map("is_pre_registered")
  estadoAcademico          EstadoAprendiz? @default(EN_FORMACION) @map("estado_academico")
  phone                    String?
  especialidad             String?
  googleId                 String?         @map("google_id")
  magicLinkToken           String?         @map("magic_link_token")
  magicLinkExpires         DateTime?       @map("magic_link_expires")
  isActive                 Boolean         @default(true) @map("is_active")
  isEmailVerified          Boolean         @default(false) @map("is_email_verified")
  emailVerificationToken   String?         @map("email_verification_token")
  emailVerificationExpires DateTime?       @map("email_verification_expires")
  resetPasswordToken       String?         @map("reset_password_token")
  resetPasswordExpires     DateTime?       @map("reset_password_expires")
  pushToken                String?         @map("push_token")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  refreshTokens            RefreshToken[]
  instructorFichas         Ficha[]              @relation("InstructorFichas")
  matriculas               Matricula[]          @relation("MatriculasAprendiz")
  asistencias              RegistroAsistencia[] @relation("AsistenciasAprendiz")
  calificacionesAprendiz   Calificacion[]       @relation("CalificacionesAprendiz")
  calificacionesInstructor Calificacion[]       @relation("CalificacionesInstructor")
  observacionesAprendiz    Observacion[]        @relation("ObservacionesAprendiz")
  observacionesInstructor  Observacion[]        @relation("ObservacionesInstructor")
  comunicados              Comunicado[]         @relation("ComunicadosAutor")
  lecturas                 LecturaComunicado[]  @relation("LecturasComunicado")
  notificaciones           Notificacion[]       @relation("NotificacionesUser")
  mensajesEnviados         Mensaje[]            @relation("MensajesSent")
  mensajesRecibidos        Mensaje[]            @relation("MensajesReceived")
  auditLogs                AuditLog[]
  evidenciasComoInstructor Evidencia[]          @relation("InstructorEvidencias")
  entregasComoAprendiz     EntregaEvidencia[]   @relation("AprendizEntregas")
  cargasAprendices         CargaAprendices[]    @relation("CargasAprendices")
  instructorAssignments    InstructorFicha[]    @relation("InstructorAssignments")

  @@map("users")
}

model RefreshToken {
  id              String    @id @default(uuid())
  token           String    @unique
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedByToken String?   @map("replaced_by_token")

  @@map("refresh_tokens")
}

model Programa {
  id                String   @id @default(uuid())
  nombre            String
  codigo            String   @unique
  nivel             String?  @default("Tecnólogo")
  duracion          String?  @default("24 meses")
  competenciasCount Int      @default(0) @map("competencias_count")
  duracionMeses     Int?     @map("duracion_meses")
  estado            String   @default("Activo")
  centroFormacion   String   @default("CTMA") @map("centro_formacion")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  fichas       Ficha[]
  competencias Competencia[]
  modulos      Modulo[]

  @@map("programas")
}

model Modulo {
  id             String   @id @default(uuid())
  nombre         String
  horasFormacion Int      @map("horas_formacion")
  programaId     String   @map("programa_id")
  programa       Programa @relation(fields: [programaId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("modulos")
}

model Ficha {
  id              String   @id @default(uuid())
  numero          String   @unique
  badgeCode       String?  @map("badge_code")
  jornada         String?  @default("Mañana")
  estado          String   @default("Activo")
  sede            String?
  trimestreActual Int?     @map("trimestre_actual")
  programaId      String   @map("programa_id")
  instructorId    String?  @map("instructor_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  programa              Programa           @relation(fields: [programaId], references: [id])
  instructor            User?              @relation("InstructorFichas", fields: [instructorId], references: [id])
  matriculas            Matricula[]
  sesiones              SesionAsistencia[]
  horarios              Horario[]
  evidencias            Evidencia[]
  cargas                CargaAprendices[]
  instructorAssignments InstructorFicha[]
  comunicados           Comunicado[]

  @@map("fichas")
}

model InstructorFicha {
  id           String   @id @default(uuid())
  fichaId      String   @map("ficha_id")
  instructorId String   @map("instructor_id")
  isLeader     Boolean  @default(false) @map("is_leader")
  createdAt    DateTime @default(now()) @map("created_at")

  ficha      Ficha @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  instructor User  @relation("InstructorAssignments", fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([fichaId, instructorId])
  @@index([fichaId, isLeader])
  @@index([instructorId])
  @@map("instructor_fichas")
}

model Matricula {
  id             String   @id @default(uuid())
  fichaId        String   @map("ficha_id")
  aprendizId     String   @map("aprendiz_id")
  trimestre      Int?     @default(1)
  sede           String?
  fechaMatricula DateTime @default(now()) @map("fecha_matricula")
  estado         String   @default("Activo")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ficha    Ficha @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  aprendiz User  @relation("MatriculasAprendiz", fields: [aprendizId], references: [id], onDelete: Cascade)

  @@unique([fichaId, aprendizId])
  @@index([fichaId])
  @@index([aprendizId])
  @@map("matriculas")
}

model CargaAprendices {
  id           String   @id @default(uuid())
  fichaId      String?  @map("ficha_id")
  uploadedById String   @map("uploaded_by_id")
  fileName     String   @map("file_name")
  fileKey      String?  @map("file_key")
  totalRows    Int      @map("total_rows")
  createdRows  Int      @map("created_rows")
  createdAt    DateTime @default(now()) @map("created_at")

  ficha      Ficha? @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("CargasAprendices", fields: [uploadedById], references: [id])

  @@index([fichaId])
  @@index([uploadedById])
  @@map("cargas_aprendices")
}


model SesionAsistencia {
  id        String   @id @default(uuid())
  fichaId   String   @map("ficha_id")
  fecha     DateTime @default(now())
  tema      String?
  createdAt DateTime @default(now()) @map("created_at")

  ficha     Ficha                @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  registros RegistroAsistencia[]

  @@index([fichaId])
  @@map("sesiones_asistencia")
}

model RegistroAsistencia {
  id          String   @id @default(uuid())
  sesionId    String   @map("sesion_id")
  aprendizId  String   @map("aprendiz_id")
  estado      String
  observacion String?
  createdAt   DateTime @default(now()) @map("created_at")

  sesion   SesionAsistencia @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  aprendiz User             @relation("AsistenciasAprendiz", fields: [aprendizId], references: [id], onDelete: Cascade)

  @@unique([sesionId, aprendizId])
  @@index([sesionId])
  @@index([aprendizId])
  @@map("registros_asistencia")
}

model Competencia {
  id         String   @id @default(uuid())
  nombre     String
  codigo     String
  programaId String   @map("programa_id")
  createdAt  DateTime @default(now()) @map("created_at")

  programa       Programa       @relation(fields: [programaId], references: [id], onDelete: Cascade)
  calificaciones Calificacion[]

  @@index([programaId])
  @@map("competencias")
}

model Calificacion {
  id            String   @id @default(uuid())
  aprendizId    String   @map("aprendiz_id")
  competenciaId String?  @map("competencia_id")
  instructorId  String?  @map("instructor_id")
  nota          Decimal  @db.Decimal(3, 1)
  periodo       String?
  estado        String?  @default("Aprobado")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  aprendiz    User         @relation("CalificacionesAprendiz", fields: [aprendizId], references: [id], onDelete: Cascade)
  competencia Competencia? @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  instructor  User?        @relation("CalificacionesInstructor", fields: [instructorId], references: [id])

  @@index([aprendizId])
  @@index([competenciaId])
  @@index([instructorId])
  @@map("calificaciones")
}

model Observacion {
  id           String   @id @default(uuid())
  aprendizId   String   @map("aprendiz_id")
  instructorId String   @map("instructor_id")
  tipo         String
  materia      String?
  descripcion  String
  fecha        DateTime @default(now())
  createdAt    DateTime @default(now()) @map("created_at")

  aprendiz   User @relation("ObservacionesAprendiz", fields: [aprendizId], references: [id], onDelete: Cascade)
  instructor User @relation("ObservacionesInstructor", fields: [instructorId], references: [id])

  @@index([aprendizId])
  @@index([instructorId])
  @@map("observaciones")
}

model Comunicado {
  id           String   @id @default(uuid())
  autorId      String   @map("autor_id")
  fichaId      String?  @map("ficha_id")
  titulo       String
  mensaje      String
  destinatario String
  createdAt    DateTime @default(now()) @map("created_at")

  // fichaId nulo = aviso global (solo lo puede crear ADMIN).
  // fichaId presente = aviso de un INSTRUCTOR, visible solo para su ficha.
  autor    User                @relation("ComunicadosAutor", fields: [autorId], references: [id])
  ficha    Ficha?              @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  lecturas LecturaComunicado[]

  @@index([autorId])
  @@index([fichaId])
  @@map("comunicados")
}

model LecturaComunicado {
  id           String   @id @default(uuid())
  comunicadoId String   @map("comunicado_id")
  userId       String   @map("user_id")
  leidoAt      DateTime @default(now()) @map("leido_at")

  comunicado Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  user       User       @relation("LecturasComunicado", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([comunicadoId, userId])
  @@index([userId])
  @@index([comunicadoId])
  @@map("lecturas_comunicados")
}

model Notificacion {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  titulo    String
  mensaje   String
  tipo      String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("NotificacionesUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, leida])
  @@index([userId])
  @@map("notificaciones")
}

model Mensaje {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receptorId String   @map("receptor_id")
  texto      String
  leido      Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("MensajesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receptor User @relation("MensajesReceived", fields: [receptorId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receptorId])
  @@map("mensajes")
}

model Horario {
  id         String   @id @default(uuid())
  fichaId    String   @map("ficha_id")
  diaSemana  String   @map("dia_semana")
  horaInicio String   @map("hora_inicio")
  horaFin    String   @map("hora_fin")
  aula       String?
  createdAt  DateTime @default(now()) @map("created_at")

  ficha Ficha @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@index([fichaId])
  @@map("horarios")
}

model ConfiguracionInstitucional {
  id           String   @id @default("singleton")
  nombreCentro String   @map("nombre_centro")
  nit          String
  direccion    String
  correo       String
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("configuracion_institucional")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accion    String
  detalles  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Evidencia {
  id            String   @id @default(uuid())
  titulo        String
  descripcion   String
  fechaLimite   DateTime @map("fecha_limite")
  fichaId       String   @map("ficha_id")
  instructorId  String   @map("instructor_id")
  archivoKey    String?  @map("archivo_key")
  archivoNombre String?  @map("archivo_nombre")
  archivoMime   String?  @map("archivo_mime")
  archivoSize   Int?     @map("archivo_size")
  createdAt     DateTime @default(now()) @map("created_at")

  ficha      Ficha              @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  instructor User               @relation("InstructorEvidencias", fields: [instructorId], references: [id], onDelete: Cascade)
  entregas   EntregaEvidencia[]

  @@index([fichaId])
  @@index([instructorId])
  @@map("evidencias")
}

model EntregaEvidencia {
  id            String    @id @default(uuid())
  evidenciaId   String    @map("evidencia_id")
  evidencia     Evidencia @relation(fields: [evidenciaId], references: [id], onDelete: Cascade)
  aprendizId    String    @map("aprendiz_id")
  aprendiz      User      @relation("AprendizEntregas", fields: [aprendizId], references: [id], onDelete: Cascade)
  archivoUrl    String?   @map("archivo_url")
  archivoKey    String?   @map("archivo_key")
  archivoNombre String?   @map("archivo_nombre")
  archivoMime   String?   @map("archivo_mime")
  archivoSize   Int?      @map("archivo_size")
  comentario    String?
  nota          Decimal?  @db.Decimal(3, 1)
  fechaEntrega  DateTime  @default(now()) @map("fecha_entrega")

  @@unique([evidenciaId, aprendizId])
  @@index([evidenciaId])
  @@index([aprendizId])
  @@map("entrega_evidencias")
}
