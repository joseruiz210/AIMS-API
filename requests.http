### AIMS API - Ejemplos de Peticiones HTTP
### Puedes usar este archivo con la extensión REST Client de VS Code o importarlo en Postman/Insomnia

@baseUrl = http://localhost:3000/api/v1
@adminToken = REEMPLAZAR_CON_TOKEN_ADMIN
@instructorToken = REEMPLAZAR_CON_TOKEN_INSTRUCTOR
@userToken = REEMPLAZAR_CON_TOKEN_APRENDIZ

# ─────────────────────────────────────────────
# HEALTH CHECK
# ─────────────────────────────────────────────

### Health Check
GET http://localhost:3000/api/health


# ─────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────

### 1. Registrar Aprendiz (correo @soy.sena.edu.co o @gmail.com)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "firstName": "María",
  "lastName": "García",
  "email": "maria.garcia@soy.sena.edu.co",
  "password": "MiPassword123",
  "phone": "+57 300 123 4567"
}

### 2. Registrar Instructor (correo @sena.edu.co)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "firstName": "Carlos",
  "lastName": "Rodríguez",
  "email": "carlos.rodriguez@sena.edu.co",
  "password": "Instructor123",
  "phone": "+57 310 987 6543"
}

### 3. Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "carlos.rodriguez@sena.edu.co",
  "password": "Instructor123"
}

### 4. Obtener usuario autenticado
GET {{baseUrl}}/auth/me
Authorization: Bearer {{userToken}}


# ─────────────────────────────────────────────
# PROGRAMAS
# ─────────────────────────────────────────────

### Listar programas
GET {{baseUrl}}/programas
Authorization: Bearer {{userToken}}

### Crear programa (ADMIN)
POST {{baseUrl}}/programas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "nombre": "Análisis y Desarrollo de Software",
  "codigo": "228106",
  "duracionMeses": 24
}

### Obtener programa por ID
GET {{baseUrl}}/programas/REEMPLAZAR_CON_PROGRAMA_ID
Authorization: Bearer {{userToken}}


# ─────────────────────────────────────────────
# MÓDULOS / COMPETENCIAS
# ─────────────────────────────────────────────

### Listar módulos de formación
GET {{baseUrl}}/modulos
Authorization: Bearer {{userToken}}

### Crear módulo de formación (ADMIN / INSTRUCTOR)
POST {{baseUrl}}/modulos
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "nombre": "Programación Orientada a Objetos",
  "horasFormacion": 120,
  "programaId": "REEMPLAZAR_CON_PROGRAMA_ID"
}


# ─────────────────────────────────────────────
# FICHAS
# ─────────────────────────────────────────────

### Listar fichas
GET {{baseUrl}}/fichas
Authorization: Bearer {{userToken}}

### Crear ficha (ADMIN / INSTRUCTOR)
POST {{baseUrl}}/fichas
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "numero": "2670145",
  "jornada": "MANANA",
  "fechaInicio": "2026-01-15T00:00:00.000Z",
  "programaId": "REEMPLAZAR_CON_PROGRAMA_ID"
}

### Asignar aprendiz a ficha
POST {{baseUrl}}/fichas/REEMPLAZAR_CON_FICHA_ID/aprendices
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "aprendizId": "REEMPLAZAR_CON_APRENDIZ_ID"
}


# ─────────────────────────────────────────────
# HORARIOS
# ─────────────────────────────────────────────

### Ver mi horario (APRENDIZ)
GET {{baseUrl}}/horarios/mi-horario
Authorization: Bearer {{userToken}}

### Crear horario de formación (INSTRUCTOR / ADMIN)
POST {{baseUrl}}/horarios
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "fichaId": "REEMPLAZAR_CON_FICHA_ID",
  "diaSemana": 1,
  "horaInicio": "07:00",
  "horaFin": "12:00",
  "ambiente": "Ambiente 204",
  "tema": "Programación Orientada a Objetos"
}


# ─────────────────────────────────────────────
# ASISTENCIA
# ─────────────────────────────────────────────

### Ver mis asistencias (APRENDIZ)
GET {{baseUrl}}/asistencia/mis-asistencias
Authorization: Bearer {{userToken}}

### Registrar asistencias de sesión (INSTRUCTOR)
POST {{baseUrl}}/asistencia/registrar
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "registros": [
    {
      "fichaAprendizId": "REEMPLAZAR_CON_FICHA_APRENDIZ_ID",
      "horarioId": "REEMPLAZAR_CON_HORARIO_ID",
      "fecha": "2026-08-26",
      "estado": "PRESENTE",
      "observacion": "Llegó puntual"
    }
  ]
}


# ─────────────────────────────────────────────
# CALIFICACIONES
# ─────────────────────────────────────────────

### Ver mis calificaciones (APRENDIZ)
GET {{baseUrl}}/calificaciones/mis-calificaciones
Authorization: Bearer {{userToken}}

### Registrar / Actualizar calificación (INSTRUCTOR)
POST {{baseUrl}}/calificaciones
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "aprendizId": "REEMPLAZAR_CON_APRENDIZ_ID",
  "fichaId": "REEMPLAZAR_CON_FICHA_ID",
  "moduloId": "REEMPLAZAR_CON_MODULO_ID",
  "nota": 4.5,
  "periodo": "2026-1"
}


# ─────────────────────────────────────────────
# EVIDENCIAS Y ENTREGAS
# ─────────────────────────────────────────────

### Listar evidencias
GET {{baseUrl}}/evidencias
Authorization: Bearer {{userToken}}

### Crear evidencia (INSTRUCTOR)
POST {{baseUrl}}/evidencias
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "titulo": "Taller Diagrama Entidad Relación",
  "descripcion": "Diseñar el DER completo para la base de datos del proyecto AIMS",
  "fechaLimite": "2026-09-05T23:59:59.000Z",
  "fichaId": "REEMPLAZAR_CON_FICHA_ID"
}

### Enviar entrega de evidencia (APRENDIZ)
POST {{baseUrl}}/evidencias/REEMPLAZAR_CON_EVIDENCIA_ID/entregas
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "archivoUrl": "https://storage.sena.edu.co/entregas/der_taller.pdf",
  "comentario": "Adjunto documento en PDF con el diseño DER"
}

### Calificar entrega (INSTRUCTOR)
PUT {{baseUrl}}/evidencias/REEMPLAZAR_CON_EVIDENCIA_ID/entregas/REEMPLAZAR_CON_ENTREGA_ID/calificar
Authorization: Bearer {{instructorToken}}
Content-Type: application/json

{
  "nota": 4.8
}


# ─────────────────────────────────────────────
# APRENDIZ DASHBOARD & NOTIFICACIONES
# ─────────────────────────────────────────────

### Obtener Dashboard del Aprendiz
GET {{baseUrl}}/aprendiz/dashboard
Authorization: Bearer {{userToken}}

### Obtener Notificaciones
GET {{baseUrl}}/notificaciones
Authorization: Bearer {{userToken}}

### Marcar todas las notificaciones como leídas
PATCH {{baseUrl}}/notificaciones/read-all
Authorization: Bearer {{userToken}}


# ─────────────────────────────────────────────
# ADMIN STATS & AUDIT LOGS
# ─────────────────────────────────────────────

### Obtener Estadísticas del Panel Admin
GET {{baseUrl}}/admin/stats
Authorization: Bearer {{adminToken}}

### Obtener Actividad Reciente / Logs de Auditoría
GET {{baseUrl}}/admin/recent-activity
Authorization: Bearer {{adminToken}}
